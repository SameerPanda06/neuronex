# NEURONEX Frontend Environment Configuration

# Runtime data mode (choose one): mock | live | replay
# mock: generated development simulation
# live: connects to the configured backend
# replay: deterministic local demo fallback; NOT live hardware telemetry
VITE_DATA_MODE=mock

# Optional replay clock multiplier (positive number, default 1)
VITE_REPLAY_SPEED=1

# Backend REST API URL (used in live mode)
VITE_API_URL=http://localhost:5000

# Backend Socket.IO URL (used in live mode)
VITE_WS_URL=ws://localhost:5000
